---
import styles from './Navbar.module.css';

interface Props {
  activePage?: 'home' | 'academic';
}

const { activePage = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = base || '/';
---
<nav class={styles.navbar}>
  <a class={styles.logo} href={homeHref}>LF<span class={styles.logoDot}>.</span></a>
  <div class={styles.navLinks}>
    <a href={homeHref} class:list={[styles.link, activePage === 'home' && styles.active]}>Inicio</a>
    <a href={`${base}/academico/`} class:list={[styles.link, activePage === 'academic' && styles.active]}>Académico</a>
    <a href={`${base}/#proyectos`} class={styles.link}>Proyectos</a>
    <a href={`${base}/#contacto`} class={styles.link}>Contacto</a>
  </div>
</nav>
