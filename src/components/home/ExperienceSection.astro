---
import styles from './ExperienceSection.module.css';

const items = [
  {
    date: '2023 — Actualidad',
    title: 'Ingeniería en Sistemas de Información',
    place: 'Universidad',
    description: 'Formación en desarrollo, análisis de sistemas, arquitectura, gestión de proyectos, bases de datos y tecnologías de la información.',
  },
  {
    date: '2025 — Actualidad',
    title: 'Desarrollo de proyectos personales y académicos',
    place: 'Proyectos independientes',
    description: 'Diseño y desarrollo de soluciones de software, exploración de tecnologías y aplicación de conocimientos de ingeniería.',
  },
];
---
<section class="section" id="experiencia">
  <div class="section-heading">
    <p class="eyebrow">04 / EXPERIENCIA</p>
    <h2>Experiencia &amp; formación</h2>
  </div>
  <div class={styles.timeline}>
    {items.map((item) => (
      <div class={styles.item}>
        <span class={styles.date}>{item.date}</span>
        <div>
          <h3 class={styles.title}>{item.title}</h3>
          <p class="muted">{item.place}</p>
          <p class={styles.description}>{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
