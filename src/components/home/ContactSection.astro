---
import styles from './ContactSection.module.css';
---
<section class:list={['section', styles.contactSection]} id="contacto">
  <div class="section-heading">
    <p class="eyebrow">05 / CONTACTO</p>
    <h2>¿Trabajamos juntos?</h2>
  </div>
  <p class="description">Estoy abierto a oportunidades, proyectos y nuevas experiencias en el mundo del desarrollo de software.</p>
  <div class={styles.links}>
    <a class={styles.link} href="mailto:tuemail@gmail.com">Email ↗</a>
    <a class={styles.link} href="https://github.com/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    <a class={styles.link} href="https://linkedin.com/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
  </div>
</section>
