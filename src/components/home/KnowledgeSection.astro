---
import styles from './KnowledgeSection.module.css';
import KnowledgeCard from './KnowledgeCard.astro';

const knowledgeAreas = [
  { icon: '01', category: 'ENGINEERING', title: 'Análisis de sistemas', description: 'Análisis de requerimientos, modelado de necesidades y planificación de soluciones.', items: ['Casos de uso', 'Epicas e Historias de usuario', 'Criterios de aceptación', 'PERT / CPM'] },
  { icon: '02', category: 'DATA', title: 'Bases de datos', description: 'Diseño, administración y procesamiento de datos en sistemas relacionales y no relacionales.', items: ['SQL / MongoDB', 'Stored Procedures, Views & Triggers', 'Redundancia'] },
  { icon: '03', category: 'ARCHITECTURE', title: 'Diseño de sistemas', description: 'Modelado estructural, diseño de software y definición de arquitectura.', items: ['Diagramas de clases', 'Patrones de diseño', 'Arquitectura de software'] },
  { icon: '04', category: 'INFRASTRUCTURE', title: 'DevOps & infraestructura', description: 'Automatización de procesos, integración, despliegue y observabilidad.', items: ['CI/CD', 'OpenTelemetry', 'Git Flow / GitHub Flow / Trunk Based', 'Infrastructure as Code', 'Docker'] },
  { icon: '05', category: 'DESIGN', title: 'UX / UI', description: 'Diseño de interfaces y experiencias centradas en las necesidades de los usuarios.', items: ['Minimum Viable Product (MVP)', 'Usabilidad', 'Accesibilidad', 'Prototipado (Figma)'] },
  { icon: '06', category: 'DEVELOPMENT', title: 'Full Stack development', description: 'Desarrollo de aplicaciones, servicios, interfaces e integración de tecnologías.', items: ['JavaScript / React', 'Java / Spring Boot', 'Docker', 'Agentes de desarrollo (OpenCode)'] },
  { icon: '07', category: 'METHODOLOGY', title: 'Metodologías ágiles', description: 'Organización del trabajo, gestión de iteraciones y mejora continua de procesos.', items: ['Scrum', 'Kanban', 'Monitoreo continuo'] },
  { icon: '08', category: 'QUALITY', title: 'Aseguramiento de calidad', description: 'Prácticas para garantizar la calidad, confiabilidad y mantenibilidad del software.', items: ['Calidad de software', 'Testing', 'Buenas prácticas de desarrollo', "SWEBoK V4"] },
  { icon: '09', category: 'DATA SCIENCE', title: 'Ciencia de datos', description: 'Procesamiento de datos, construcción de modelos y técnicas de aprendizaje automático.', items: ['Deep Learning', 'Feature Engineering', 'Redes neuronales convolucionales (CNN)', 'Machine Learning'] },
  { icon: '10', category: 'SECURITY', title: 'Ciberseguridad', description: 'Principios de seguridad aplicados a los sistemas y al contexto organizacional.', items: ['Seguridad en sistemas', 'Seguridad organizacional', 'Gestión de riesgos', 'Protección de información', "Confidencialidad, integridad y disponibilidad"] },
  { icon: '11', category: 'MANAGEMENT', title: 'Project management', description: 'Planificación, organización y coordinación de equipos y proyectos de software.', items: ['Asignación de roles', 'Enfoques de trabajo'] },
];
---
<section class="section" id="conocimientos">
  <div class="section-heading">
    <p class="eyebrow">02 / KNOWLEDGE</p>
    <h2>Áreas de conocimiento</h2>
    <p class="description">
      Formación integral en ingeniería de software, desarrollo, arquitectura,
      datos y gestión de proyectos.
    </p>
  </div>
  <div class={styles.grid}>
    {knowledgeAreas.map((area) => <KnowledgeCard {...area} />)}
  </div>
</section>
