---
import styles from './Hero.module.css';

const base = import.meta.env.BASE_URL;
---
<section class={styles.hero}>
  <div class={styles.heroContent}>
    <p class="eyebrow">INGENIERÍA EN SISTEMAS DE INFORMACIÓN</p>
    <h1 class={styles.title}>Hola, soy <span class={styles.accent}>Lucas.</span></h1>
    <h2 class={styles.subtitle}>Desarrollo soluciones a través de la tecnología.</h2>
    <p class="description">
      Estudiante de Ingeniería en Sistemas de Información, interesado en el desarrollo
      de software, diseño de sistemas, arquitectura y tecnologías emergentes.
    </p>
    <div class={styles.heroButtons}>
      <a href={`${base}#proyectos`} class="btn-primary">Ver proyectos</a>
      <a href={`${base}#contacto`} class="btn-secondary">Contactarme</a>
    </div>
  </div>
  <div class={styles.heroCard}>
    <div class={styles.profilePlaceholder}>LF</div>
    <p class={styles.status}><span class={styles.dot}></span> Disponible para oportunidades</p>
    <h3 class={styles.cardTitle}>Software Engineer</h3>
    <p class="muted">Buenos Aires, Argentina</p>
  </div>
</section>
