---
import styles from './ProjectsSection.module.css';

const projects = [
  { number: '01', type: 'Full Stack', title: 'Sistema de gestión', description: 'Aplicación orientada a la gestión de clientes, proyectos, documentación y recursos de una organización.', tags: ['Java', 'Spring', 'MySQL'], href: '#' },
  { number: '02', type: 'Data Science', title: 'Clasificación de sentimientos', description: 'Modelo de machine learning para analizar opiniones y clasificar sentimientos a partir de textos.', tags: ['Python', 'Scikit-learn', 'NLP'], href: '#' },
  { number: '03', type: 'Software Engineering', title: 'Diseño de sistemas', description: 'Análisis funcional, modelado, arquitectura, planificación y diseño de soluciones de software.', tags: ['UML', 'Scrum', 'Arquitectura'], href: '#' },
];
---
<section class="section" id="proyectos">
  <div class="section-heading">
    <p class="eyebrow">03 / TRABAJO</p>
    <h2>Proyectos destacados</h2>
  </div>
  <div class={styles.grid}>
    {projects.map((project) => (
      <article class={styles.card}>
        <div class={styles.top}>
          <span class={styles.number}>{project.number}</span>
          <span class={styles.type}>{project.type}</span>
        </div>
        <h3 class={styles.title}>{project.title}</h3>
        <p class={styles.description}>{project.description}</p>
        <div class={styles.tags}>
          {project.tags.map((tag) => <span class={styles.tag}>{tag}</span>)}
        </div>
        <a href={project.href} class={styles.link}>Ver proyecto ↗</a>
      </article>
    ))}
  </div>
</section>
